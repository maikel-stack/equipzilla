# === Google Ads API — credenciales ===
# Copia este archivo a  .env  (sin .example) y rellena tus valores REALES.
# El archivo .env esta en .gitignore: NUNCA se sube al repo.
#
# IMPORTANTE: si pegaste alguna de estas claves en un chat, REGENERALA antes de usarla.

# Developer token del MCC (API Center). Debe estar aprobado (Basic) para cuentas reales.
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth 2.0 (Google Cloud Console > Credenciales > ID de cliente OAuth tipo "Desktop")
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Refresh token: generalo con  python generate_refresh_token.py  (usa client_id/secret de arriba)
GOOGLE_ADS_REFRESH_TOKEN=

# Customer ID de la cuenta de Equipzilla, 10 digitos SIN guiones (ej: 9726619164)
GOOGLE_ADS_CUSTOMER_ID=

# Login customer ID = tu MCC, 10 digitos SIN guiones. Dejar vacio si la cuenta no cuelga de un MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
