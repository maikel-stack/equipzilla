# Copia a .env y rellena. NO subas .env al repo.

# Obligatoria — clave de la API de Claude (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Opcional — MCP de Apollo.io para enriquecimiento de empresa/personas en el agente Lead Intelligence.
# Sin esto, el enriquecimiento se hace solo con web_search y los datos no hallados quedan en null/low.
APOLLO_MCP_URL=
APOLLO_MCP_TOKEN=
