# Copia a .env y rellena. NO subas .env al repo.

# Obligatoria — clave de la API de Claude (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Prospección de construcción — API key de Apollo (Settings → Integrations → API).
# La usa equipzilla-crm-ai/prospecting/apollo-prospect.js para buscar decisores y revelar emails.
APOLLO_API_KEY=

# Opcional — MCP de Apollo.io para enriquecimiento dentro del agente Lead Intelligence.
# Sin esto, el enriquecimiento del agente se hace solo con web_search (null/low si no encuentra).
APOLLO_MCP_URL=
APOLLO_MCP_TOKEN=
