# ─────────────────────────────────────────────────────────────
# Equipzilla - Configuracion de entorno
# Copia este archivo a ".env" y rellena tus valores reales.
#   cp .env.example .env
# El archivo .env NUNCA debe subirse al repositorio.
# ─────────────────────────────────────────────────────────────

# --- Proveedor de imagen activo ---------------------------------
# Opciones soportadas: "gemini" (por defecto) | "flux"
IMAGE_PROVIDER=gemini

# --- Google Gemini (Nano Banana / Gemini Flash Image) -----------
# Consigue tu API key en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de edicion image-to-image + inpainting.
# "Nano Banana" corresponde a la familia Gemini Flash Image.
GEMINI_MODEL=gemini-2.5-flash-image-preview

# Coste estimado por imagen generada (USD). Solo para el manifest.json.
# Ajusta segun el pricing vigente de tu proveedor.
COST_PER_IMAGE_USD=0.039

# --- FLUX.1 Kontext (alternativa, stub) -------------------------
# Solo necesario si IMAGE_PROVIDER=flux
FLUX_API_KEY=
FLUX_MODEL=flux-kontext-pro
